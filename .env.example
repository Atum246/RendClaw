# ============================================================
# 🎨🦞 RendClaw — Environment Variables Reference
# Copy this to .env and fill in your values
# ============================================================

# ─── Required ───────────────────────────────────────────────
# Your LLM provider API key
LLM_API_KEY=sk-your-api-key-here

# Model to use (provider/model format)
LLM_MODEL=anthropic/claude-sonnet-4-6

# Password to secure your RendClaw Control UI
GATEWAY_TOKEN=your-strong-password-here

# ─── Platform (auto-detected on Render) ────────────────────
# NEOCLAW_PLATFORM=render
# RENDER_EXTERNAL_URL=auto-detected

# ─── Telegram (Optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=
# TELEGRAM_USER_IDS=123456,789012

# ─── WhatsApp (Optional) ──────────────────────────────────
WHATSAPP_ENABLED=false

# ─── Discord (Optional) ───────────────────────────────────
DISCORD_TOKEN=

# ─── Slack (Optional) ─────────────────────────────────────
SLACK_TOKEN=

# ─── Backup — GitHub Gist (Recommended for Render) ────────
GITHUB_GIST_TOKEN=
GITHUB_GIST_ID=              # Leave empty — auto-created & persisted on first sync
SYNC_INTERVAL=120            # Seconds between sync checks

# ─── Backup — HuggingFace Datasets (Optional) ─────────────
HF_USERNAME=
HF_TOKEN=
BACKUP_DATASET_NAME=rendclaw-backup

# ─── Backup — S3 (Optional) ───────────────────────────────
S3_BACKUP_BUCKET=
S3_REGION=us-east-1

# ─── Keep-Alive ───────────────────────────────────────────
UPTIMEROBOT_API_KEY=
CRONJOB_ORG_KEY=
# NEOCLAW_EXTERNAL_URL=https://your-service.onrender.com
SELF_PING_INTERVAL=600000

# ─── Webhooks (Optional) ──────────────────────────────────
WEBHOOK_URL=

# ─── Security (Optional) ──────────────────────────────────
OPENCLAW_PASSWORD=
ALLOWED_ORIGINS=https://your-service.onrender.com
